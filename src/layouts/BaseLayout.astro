---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteMotion from "../components/SiteMotion.astro";
import { alternatePathFor, languageForPath, localeMeta, type Language } from "../data/i18n";
import { site } from "../data/site";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/content.css";
import "../styles/seo-checkup.css";
import "../styles/skill-packs.css";
import "../styles/responsive.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath: string;
  bodyClass?: string;
  robots?: "noindex, follow";
  pageType?: "WebPage" | "CollectionPage";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Language;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath,
  bodyClass = "",
  robots,
  pageType = "WebPage",
  structuredData,
  lang = languageForPath(canonicalPath)
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, site.origin).href;
const alternatePath = alternatePathFor(canonicalPath);
const alternateUrl = alternatePath ? new URL(alternatePath, site.origin).href : undefined;
const deUrl = lang === "de" ? canonicalUrl : alternateUrl;
const enUrl = lang === "en" ? canonicalUrl : alternateUrl;
const pageTitle = title === site.title ? title : `${title} | SEO AI Agent`;
const websiteId = `${site.origin}/#website`;
const pageSchema = {
  "@type": pageType,
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageTitle,
  description,
  inLanguage: lang,
  isPartOf: { "@id": websiteId }
};
const additionalSchemas = (structuredData
  ? Array.isArray(structuredData) ? structuredData : [structuredData]
  : []).map(({ "@context": _context, ...schema }) => schema);
const graph = [
  ...(canonicalPath === "/" ? [{
    "@type": "WebSite",
    "@id": websiteId,
    name: "SEO AI Agent",
    url: `${site.origin}/`,
    description: site.description,
    inLanguage: site.language
  }] : []),
  pageSchema,
  ...additionalSchemas
];
const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robots && <meta name="robots" content={robots} />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {deUrl && <link rel="alternate" hreflang="de" href={deUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {deUrl && <link rel="alternate" hreflang="x-default" href={deUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMeta[lang].locale} />
    <meta property="og:locale:alternate" content={localeMeta[lang].otherLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SEO AI Agent" />
    <meta property="og:image" content={`${site.origin}/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === "de" ? "SEO AI Agent – prüfbare Aufgaben und reale Evidenz" : "SEO AI Agent – reviewable tasks and visible evidence"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.origin}/social-card.png`} />
    <meta name="twitter:image:alt" content={lang === "de" ? "SEO AI Agent – prüfbare Aufgaben und reale Evidenz" : "SEO AI Agent – reviewable tasks and visible evidence"} />
    <meta name="theme-color" content="#090d0c" />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{localeMeta[lang].skip}</a>
    <div class="site-frame">
      <SiteHeader currentPath={canonicalPath} lang={lang} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter lang={lang} />
    </div>
    <SiteMotion />
  </body>
</html>
