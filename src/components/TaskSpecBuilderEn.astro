---
import { tasksEn } from "../data/tasks";

const sourceOptions = [...new Set(tasksEn.flatMap((task) => task.allowedSources))];
const initialTask = tasksEn[0];
---

<section class="builder" data-task-builder-en data-reveal>
  <div class="builder-status" aria-live="polite"><span>Local status</span><strong data-local-status>All fields complete</strong></div>
  <div class="recipe-mode-bar">
    <div class="mode-switch" aria-label="Data mode"><span>Mode</span><button type="button" class="mode-option active" aria-pressed="true"><i aria-hidden="true"></i>Without MCP</button><button type="button" class="mode-option" aria-pressed="false" aria-disabled="true" data-live-mode><i aria-hidden="true"></i>With real data</button></div>
    <div class="recipe-promise"><strong>Task Recipe</strong><span>Prompt, data needs, limits, and evidence in one contract.</span></div>
  </div>
  <div class="step-rail" aria-label="Specification sections">
    {[["01", "Task", "task-fields-en"], ["02", "Evidence", "evidence-fields-en"], ["03", "Access", "access-fields-en"], ["04", "Budget", "limit-fields-en"], ["05", "Review", "acceptance-fields-en"]].map(([number, label, target], index) => <button type="button" class:list={{ active: index === 0 }} data-step-target={target} data-flow-node><span>{number}</span>{label}</button>)}
  </div>
  <div class="builder-workspace">
    <form class="spec-form">
      <div class="active-task"><label for="task-id-en">Selected recipe</label><select id="task-id-en" name="taskId">{tasksEn.map((task) => <option value={task.slug}>{task.title}</option>)}</select></div>
      <fieldset id="task-fields-en">
        <legend>01 / Task</legend>
        <label for="goal-en">Goal</label><textarea id="goal-en" name="goal" rows="4">{initialTask.goal}</textarea>
        <label for="domain-en">Domain</label><div><input id="domain-en" name="domain" type="url" inputmode="url" value="https://your-domain.com" /><p class="field-help inline-help">Stays local to this recipe.</p></div>
        <label for="in-scope-en">In scope</label><textarea id="in-scope-en" name="inScope" rows="4">{initialTask.inScope.join("\n")}</textarea>
        <label for="out-of-scope-en">Out of scope</label><textarea id="out-of-scope-en" name="outOfScope" rows="3">{initialTask.outOfScope.join("\n")}</textarea>
      </fieldset>
      <fieldset id="evidence-fields-en">
        <legend>02 / Evidence</legend><p class="field-help">Select only sources that are actually available.</p>
        <div class="source-options">{sourceOptions.map((source) => <label><input type="checkbox" name="sources" value={source} checked={initialTask.allowedSources.includes(source as never)} /><span>{source}</span></label>)}</div>
        <label for="freshness-policy-en">Freshness</label><select id="freshness-policy-en" name="freshnessPolicy"><option value="providedOnly">Provided data only</option><option value="storedOnly">Stored MCP data</option></select>
      </fieldset>
      <fieldset id="access-fields-en">
        <legend>03 / Access</legend><label for="access-mode-en">Access mode</label><select id="access-mode-en" name="accessMode"><option value="read-only">Read-only</option><option value="propose-only">Propose changes only</option></select><p class="field-help">Write access is deliberately unavailable in this specification.</p>
      </fieldset>
      <fieldset id="limit-fields-en" class="limit-grid">
        <legend>04 / Budget</legend><div><label for="time-limit-en">Time limit</label><div class="input-unit"><input id="time-limit-en" name="timeLimit" type="number" min="1" max="480" value={initialTask.timeLimitMinutes} /><span>minutes</span></div></div><div><label for="cost-limit-en">Cost limit</label><div class="input-unit"><input id="cost-limit-en" name="costLimit" type="number" min="0" max="1000" step="0.01" value={initialTask.costLimitEuro} /><span>EUR</span></div></div>
      </fieldset>
      <fieldset id="acceptance-fields-en">
        <legend>05 / Review</legend><label for="expected-output-en">Expected output</label><textarea id="expected-output-en" name="expectedOutput" rows="4">{initialTask.expectedOutput}</textarea><label for="stop-rule-en">Stop rule</label><textarea id="stop-rule-en" name="stopRule" rows="4">{initialTask.stopRule}</textarea>
      </fieldset>
      <div class="builder-actions"><button class="button button-primary" type="submit">Update Task Recipe</button><button class="button button-secondary" type="button" data-copy-markdown>Copy Markdown</button><button class="button button-secondary" type="button" data-download-json>Download JSON</button></div>
      <p class="action-status" aria-live="polite" data-action-status>The specification stays in this browser.</p>
    </form>
    <aside class="connection-panel" aria-labelledby="connection-title-en">
      <header><span class="connection-orbit" aria-hidden="true"></span><div><p>Data connection</p><h2 id="connection-title-en">Contextter MCP</h2></div></header>
      <button type="button" class="button button-disabled" disabled>MCP pilot in preparation</button><p class="connection-state"><i aria-hidden="true"></i>Not connected</p>
      <div class="capability-list"><h3>Required capabilities</h3><ul data-capabilities>{initialTask.requiredCapabilities.map((capability) => <li>{capability}</li>)}</ul></div>
      <div class="connection-policy"><span aria-hidden="true">i</span><p>Contextter shares the same operator. No automatic rating.</p></div>
      <p class="connection-help">Connect becomes available only after OAuth, scopes, and at least one read tool are verified live.</p>
      <p class="connection-disclosure"><strong>Common ownership:</strong> Contextter, seo-mcp.de, and this website belong to the same portfolio. These are information paths, not independent recommendations.</p>
      <nav class="connection-links" aria-label="Capability and MCP information"><a href="/en/capabilities">Review required capabilities</a><a href="/en/mcp-for-seo-agents">Understand MCP for SEO agents</a><a href="https://seo-mcp.de/capabilities">SEO MCP Capability Explorer</a><a href="https://contextter.com/">Contextter product context</a></nav>
    </aside>
    <aside class="spec-output" aria-label="Current specification">
      <header><h2>TASK RECIPE / <span data-output-id>{initialTask.id}</span></h2><label for="output-format-en">Format</label><select id="output-format-en" data-output-format aria-label="Output format"><option value="markdown">Markdown</option><option value="json">JSON</option></select></header>
      <div class="output-body"><pre tabindex="0"><code data-spec-output></code></pre><div class="validation-rail"><h3>Validation</h3><ol>{["ID", "Goal & domain", "Scope", "Sources", "Access", "Limits", "Output", "Stop rule", "Schema"].map((label) => <li data-validation-item><span aria-hidden="true"></span><b>{label}</b><em>OK</em></li>)}</ol><output data-validation-total>9 / 9 fields</output></div></div>
      <footer><span>SCHEMA / TASK-SPEC.V1.JSON</span><span data-output-time>LOCAL</span></footer>
    </aside>
  </div>
</section>

<script>
  import { tasksEn } from "../data/tasks";
  import gsap from "gsap";

  const root = document.querySelector<HTMLElement>("[data-task-builder-en]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>(".spec-form")!;
    const output = root.querySelector<HTMLElement>("[data-spec-output]")!;
    const outputId = root.querySelector<HTMLElement>("[data-output-id]")!;
    const outputFormat = root.querySelector<HTMLSelectElement>("[data-output-format]")!;
    const validationItems = [...root.querySelectorAll<HTMLElement>("[data-validation-item]")];
    const validationTotal = root.querySelector<HTMLOutputElement>("[data-validation-total]")!;
    const localStatus = root.querySelector<HTMLElement>("[data-local-status]")!;
    const actionStatus = root.querySelector<HTMLElement>("[data-action-status]")!;
    const outputTime = root.querySelector<HTMLElement>("[data-output-time]")!;
    const taskSelect = form.elements.namedItem("taskId") as HTMLSelectElement;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    const lines = (value: string) => value.split("\n").map((line) => line.trim()).filter(Boolean);
    const selectedSources = () => [...form.querySelectorAll<HTMLInputElement>('input[name="sources"]:checked')].map((item) => item.value);
    const buildSpec = () => {
      const selected = tasksEn.find((task) => task.slug === taskSelect.value) ?? tasksEn[0];
      return { schema: "task-spec.v1", id: selected.id, version: selected.version, task: selected.title, target: { domain: field("domain").value.trim() }, goal: field("goal").value.trim(), in_scope: lines(field("inScope").value), out_of_scope: lines(field("outOfScope").value), allowed_sources: selectedSources(), required_capabilities: [...selected.requiredCapabilities], data_connection: { provider: "contextter", status: "not_connected", execution_available: false, freshness_policy: field("freshnessPolicy").value }, access: { mode: field("accessMode").value, write_allowed: false }, limits: { time_minutes: Number(field("timeLimit").value), cost_eur: Number(field("costLimit").value) }, expected_output: field("expectedOutput").value.trim(), stop_rule: field("stopRule").value.trim(), review_required: true };
    };
    const toMarkdown = (spec: ReturnType<typeof buildSpec>) => [`# Task Recipe: ${spec.task}`, "", `- ID: ${spec.id}`, `- Version: ${spec.version}`, `- Access: ${spec.access.mode}; write access: no`, `- Time limit: ${spec.limits.time_minutes} minutes`, `- Cost limit: ${spec.limits.cost_eur.toFixed(2)} EUR`, "", "## Goal", spec.goal, "", "## In scope", ...spec.in_scope.map((item) => `- ${item}`), "", "## Out of scope", ...spec.out_of_scope.map((item) => `- ${item}`), "", "## Allowed sources", ...spec.allowed_sources.map((item) => `- ${item}`), "", "## Required MCP capabilities", ...spec.required_capabilities.map((item) => `- ${item}`), "", "MCP status: not connected; no live execution.", "", "## Expected output", spec.expected_output, "", "## Stop rule", spec.stop_rule, "", "Human review is required."].join("\n");
    const render = () => {
      const spec = buildSpec();
      const checks = [Boolean(spec.id), Boolean(spec.goal) && /^https?:\/\//.test(spec.target.domain), spec.in_scope.length > 0 && spec.out_of_scope.length > 0, spec.allowed_sources.length > 0, Boolean(spec.access.mode) && spec.access.write_allowed === false, spec.limits.time_minutes > 0 && spec.limits.cost_eur >= 0, Boolean(spec.expected_output), Boolean(spec.stop_rule), spec.schema === "task-spec.v1"];
      output.textContent = outputFormat.value === "markdown" ? toMarkdown(spec) : JSON.stringify(spec, null, 2);
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) gsap.fromTo(output, { autoAlpha: 0.58, y: 5 }, { autoAlpha: 1, y: 0, duration: 0.2, ease: "power2.out", overwrite: "auto" });
      outputId.textContent = spec.id;
      checks.forEach((passed, index) => { validationItems[index].classList.toggle("invalid", !passed); validationItems[index].querySelector("em")!.textContent = passed ? "OK" : "MISSING"; });
      const complete = checks.filter(Boolean).length;
      validationTotal.textContent = `${complete} / ${checks.length} fields`;
      localStatus.textContent = complete === checks.length ? "All fields complete" : `${checks.length - complete} fields open`;
      outputTime.textContent = `UPDATED / ${new Intl.DateTimeFormat("en", { hour: "2-digit", minute: "2-digit" }).format(new Date())}`;
    };
    const applyTask = (slug: string) => {
      const task = tasksEn.find((item) => item.slug === slug) ?? tasksEn[0]; taskSelect.value = task.slug; field("goal").value = task.goal; field("inScope").value = task.inScope.join("\n"); field("outOfScope").value = task.outOfScope.join("\n"); field("accessMode").value = task.accessMode; field("timeLimit").value = String(task.timeLimitMinutes); field("costLimit").value = String(task.costLimitEuro); field("expectedOutput").value = task.expectedOutput; field("stopRule").value = task.stopRule;
      form.querySelectorAll<HTMLInputElement>('input[name="sources"]').forEach((item) => { item.checked = task.allowedSources.includes(item.value as never); });
      root.querySelector<HTMLElement>("[data-capabilities]")!.replaceChildren(...task.requiredCapabilities.map((capability) => { const item = document.createElement("li"); item.textContent = capability; return item; })); render();
    };
    form.addEventListener("input", render); form.addEventListener("submit", (event) => { event.preventDefault(); render(); actionStatus.textContent = "Task Recipe updated locally."; }); taskSelect.addEventListener("change", () => applyTask(taskSelect.value)); outputFormat.addEventListener("change", render);
    root.querySelector("[data-live-mode]")?.addEventListener("click", () => { actionStatus.textContent = "The Contextter MCP pilot is not connected. This recipe stays local."; });
    root.querySelector("[data-copy-markdown]")?.addEventListener("click", async () => { try { await navigator.clipboard.writeText(toMarkdown(buildSpec())); actionStatus.textContent = "Markdown copied."; } catch { outputFormat.value = "markdown"; render(); actionStatus.textContent = "Copy was blocked. Use the Markdown output."; } });
    root.querySelector("[data-download-json]")?.addEventListener("click", () => { const spec = buildSpec(); const url = URL.createObjectURL(new Blob([JSON.stringify(spec, null, 2)], { type: "application/json" })); const link = document.createElement("a"); link.href = url; link.download = `${spec.id.toLowerCase()}-${taskSelect.value}.json`; link.click(); URL.revokeObjectURL(url); actionStatus.textContent = "JSON file created."; });
    root.querySelectorAll<HTMLButtonElement>("[data-step-target]").forEach((button) => button.addEventListener("click", () => { root.querySelectorAll("[data-step-target]").forEach((item) => item.classList.remove("active")); button.classList.add("active"); const target = document.getElementById(button.dataset.stepTarget ?? ""); target?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" }); target?.querySelector<HTMLElement>("input, textarea, select")?.focus({ preventScroll: true }); }));
    applyTask(new URLSearchParams(location.search).get("task") ?? tasksEn[0].slug);
  }
</script>
