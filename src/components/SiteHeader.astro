---
import { alternatePathFor, navigation, type Language } from "../data/i18n";

interface Props {
  currentPath: string;
  lang?: Language;
}

const { currentPath, lang = "de" } = Astro.props;
const alternatePath = alternatePathFor(currentPath) ?? (lang === "de" ? "/en" : "/");
const labels = lang === "de"
  ? { home: "SEO AI Agent – Startseite", action: "Skill erstellen", menu: "Menü", open: "Navigation öffnen", nav: "Hauptnavigation", mobile: "Mobile Navigation", switch: "Read in English" }
  : { home: "SEO AI Agent – Home", action: "Create skill", menu: "Menu", open: "Open navigation", nav: "Main navigation", mobile: "Mobile navigation", switch: "Auf Deutsch lesen" };
const homePath = lang === "de" ? "/" : "/en";
const builderPath = lang === "de" ? "/seo-agent-skill" : "/en/seo-agent-skill";
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(href + "/");
---

<header class="site-header" data-reveal>
  <a class="brand" href={homePath} aria-label={labels.home}>
    <svg aria-hidden="true" viewBox="0 0 32 32">
      <path d="M3 12V3h9M20 3h9v9M29 20v9h-9M12 29H3v-9" />
      <circle cx="16" cy="16" r="3" />
    </svg>
    <span>SEO AI AGENT</span>
  </a>

  <nav class="desktop-nav" aria-label={labels.nav}>
    {navigation[lang].map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>

  <div class="header-tools">
    <a class="language-switch" href={alternatePath} hreflang={lang === "de" ? "en" : "de"}>{lang === "de" ? "EN" : "DE"}<span class="sr-only"> · {labels.switch}</span></a>
    <a class="header-action" href={builderPath}>
      <span>{labels.action}</span>
      <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
    </a>
  </div>

  <details class="mobile-menu">
    <summary aria-label={labels.open}>
      <span>{labels.menu}</span>
      <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 7h12M4 13h12" /></svg>
    </summary>
    <nav aria-label={labels.mobile}>
      {navigation[lang].map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a href={lang === "de" ? "/faehigkeiten" : "/en/capabilities"}>{lang === "de" ? "Fähigkeiten" : "Capabilities"}</a>
      <a href={lang === "de" ? "/methodik-und-konflikte" : "/en/methodology"}>{lang === "de" ? "Methodik" : "Methodology"}</a>
      <a href={alternatePath} hreflang={lang === "de" ? "en" : "de"}>{labels.switch}</a>
    </nav>
  </details>
</header>
