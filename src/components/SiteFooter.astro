---
import { site } from "../data/site";
import type { Language } from "../data/i18n";

interface Props { lang?: Language; }
const { lang = "de" } = Astro.props;
const links = lang === "de" ? [
  ["/skill-packs", "Skill Packs"], ["/seo-agent-skill", "Skill erstellen"], ["/seo-agent-skill-check", "Skill Check"], ["/seo-agent-policy-generator", "Policy"],
  ["/agent-skill-vergleich", "Formatvergleich"], ["/workflows", "Workflows"], ["/aufgaben", "Aufgaben"],
  ["/faehigkeiten", "Fähigkeiten"], ["/benchmarks", "Runs"], ["/mcp-fuer-seo-agenten", "MCP für Agenten"],
  ["/agenten-vergleich", "Vergleich"], ["/seo-agent-kosten", "Kosten"], ["/fehlerbehandlung-seo-agenten", "Fehlerbehandlung"],
  ["/methodik-und-konflikte", "Methodik"], ["/quellen-und-rechte", "Quellen & Rechte"],
  ["/impressum", "Impressum"], ["/datenschutz", "Datenschutz"]
] : [
  ["/en/skill-packs", "Skill Packs"], ["/en/seo-agent-skill", "Create skill"], ["/en/seo-agent-skill-check", "Skill Check"], ["/en/seo-agent-policy-generator", "Policy"],
  ["/en/agent-skill-comparison", "Format comparison"], ["/en/workflows", "Workflows"], ["/en/tasks", "Tasks"],
  ["/en/capabilities", "Capabilities"], ["/en/runs", "Runs"], ["/en/mcp-for-seo-agents", "MCP for agents"],
  ["/en/agent-comparison", "Comparison"], ["/en/seo-agent-costs", "Costs"], ["/en/failure-handling", "Failure handling"],
  ["/en/methodology", "Methodology"], ["/en/sources-and-rights", "Sources & rights"],
  ["/en/legal-notice", "Legal notice"], ["/en/privacy", "Privacy"]
];
---

<footer class="site-footer">
  <div class="footer-brand">
    <span>SEO AI AGENT</span>
    <p>{lang === "de" ? "SEO Agent Skills erstellen. Direkt kopieren. Klar arbeiten." : "Create SEO Agent Skills. Copy instantly. Work clearly."}</p>
  </div>
  <nav aria-label="Fußnavigation">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
    <a href={site.githubUrl}>GitHub</a>
  </nav>
  <div class="footer-meta">
    <p><span class="status-dot" aria-hidden="true"></span> {lang === "de" ? "Indexierbarer Launch" : "Indexable launch"} · {site.reviewedAt}</p>
    <p>{lang === "de" ? "Korrekturen und Anbieterantworten werden dokumentiert." : "Corrections and vendor responses are documented."}</p>
  </div>
</footer>
