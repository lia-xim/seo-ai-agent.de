---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoAgentSkillChecker from "../../components/SeoAgentSkillChecker.astro";
---

<BaseLayout
  lang="en"
  title="SEO Agent Skill Checker: review and repair"
  description="Review and repair SKILL.md files, Cursor Rules, and SEO-agent prompts locally with format-specific rules and a reproducible SHA-256 QA report."
  canonicalPath="/en/seo-agent-skill-check"
  bodyClass="skill-check-page"
  structuredData={{ "@context": "https://schema.org", "@type": "SoftwareApplication", name: "SEO Agent Skill Checker", url: "https://seo-ai-agent.de/en/seo-agent-skill-check", applicationCategory: "DeveloperApplication", operatingSystem: "Web", inLanguage: "en", description: "Browser-local deterministic check with fix blocks for SKILL.md files, Cursor Rules, and SEO-agent prompts.", offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" } }}
>
  <section class="checker-hero"><div><h1>Review your SEO Agent Skill. Repair it directly.</h1><p>Paste a SKILL.md file, Cursor Rule, or prompt. Get format-specific checks, directly applicable fix blocks, and a versioned QA report — locally in your browser, without an LLM.</p></div><p>Ruleset v1.2 · local · repairable</p></section>
  <SeoAgentSkillChecker lang="en" />
  <p class="checker-source-note">Format sources: <a href="https://geminicli.com/docs/cli/tutorials/skills-getting-started/">Gemini CLI Skills</a> · <a href="https://docs.cursor.com/context/rules-for-ai">Cursor Rules and AGENTS.md</a> · <a href="/en/agent-skill-comparison">full format comparison</a></p>
  <section class="checker-explainer"><div><h2>The check reviews rules. Not outcomes.</h2><p>A complete skill can still be applied incorrectly. Real quality requires a frozen task run with real inputs, versions, raw observations, and review status. File rules therefore distinguish SKILL.md, Cursor Rule, and prompt formats.</p></div><div><a class="button button-secondary" href="/en/skill-packs">Open skill packs</a><a class="text-link" href="/en/runs">Review real task runs</a></div></section>
</BaseLayout>
