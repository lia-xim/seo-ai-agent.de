---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoAgentSkillChecker from "../../components/SeoAgentSkillChecker.astro";
---

<BaseLayout
  lang="en"
  title="SEO Agent Skill Checker: review and repair"
  description="Review and repair SKILL.md files, Cursor Rules, and SEO-agent prompts locally with format-specific rules and a reproducible SHA-256 QA report."
  canonicalPath="/en/seo-agent-skill-check"
  bodyClass="skill-check-page"
  structuredData={{ "@context": "https://schema.org", "@type": "SoftwareApplication", name: "SEO Agent Skill Checker", url: "https://seo-ai-agent.de/en/seo-agent-skill-check", applicationCategory: "DeveloperApplication", operatingSystem: "Web", inLanguage: "en", description: "Browser-local deterministic check with fix blocks for SKILL.md files, Cursor Rules, and SEO-agent prompts.", offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" } }}
>
  <section class="checker-hero"><div><h1>Check an SEO Agent Skill.</h1><p>Paste it, choose the target, and repair the issues. Everything stays in your browser.</p></div></section>
  <SeoAgentSkillChecker lang="en" />
  <details class="checker-notes"><summary>Rules and limitations</summary><p>The check evaluates documented structure, not execution quality. Format sources: <a href="https://geminicli.com/docs/cli/tutorials/skills-getting-started/">Gemini CLI</a>, <a href="https://docs.cursor.com/context/rules-for-ai">Cursor</a>, and the <a href="/en/agent-skill-comparison">format comparison</a>.</p></details>
</BaseLayout>
