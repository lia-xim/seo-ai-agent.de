---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoAgentSkillGenerator from "../../components/SeoAgentSkillGenerator.astro";
---

<BaseLayout
  lang="en"
  title="Best SEO Agent Skill: Free Generator"
  description="Create a ready-to-use SEO Agent Skill as a prompt or SKILL.md — free, local, and without sign-up."
  canonicalPath="/en/seo-agent-skill"
  bodyClass="skill-page"
  structuredData={{ "@context": "https://schema.org", "@type": "SoftwareApplication", name: "SEO Agent Skill Generator", url: "https://seo-ai-agent.de/en/seo-agent-skill", applicationCategory: "BusinessApplication", operatingSystem: "Web", inLanguage: "en", description: "A local generator for an evidence-led SEO Agent Skill.", offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" } }}
>
  <section class="skill-hero">
    <div><h1>Your best SEO Agent Skill. In 30 seconds.</h1><p>Choose the task, add the website, and copy a task-specific SEO operating instruction instead of a generic prompt.</p></div>
    <p>No sign-up · no API · free</p>
  </section>
  <SeoAgentSkillGenerator lang="en" />
  <section class="skill-usage" aria-labelledby="skill-usage-title">
    <div><h2 id="skill-usage-title">One skill, two simple options.</h2><p>Paste it into your agent or save it as <code>SKILL.md</code>. The expert method, evidence labels, stop rules, and transparent tool selection are already included.</p></div>
    <ol><li><span>01</span><strong>Use as a prompt</strong><p>Copy everything, paste it into the agent, and start.</p></li><li><span>02</span><strong>Use as a skill file</strong><p>Download <code>SKILL.md</code> and place it in your existing skills directory.</p></li></ol>
  </section>
  <section class="skill-check-handoff"><div><h2>Edited it or copied it from somewhere else?</h2><p>The local Skill Check reviews twelve minimum rules for structure, evidence, data claims, write permissions, and prompt injection. No upload.</p></div><a class="button button-secondary" href="/en/seo-agent-skill-check">Check this skill</a></section>
  <section class="skill-ecosystem" aria-labelledby="skill-inputs-title">
    <header><h2 id="skill-inputs-title">Fits directly into your SEO tool flow.</h2><p>Each link serves a concrete step. All named websites share the same operator and are not independent recommendations.</p></header>
    <div>
      <a href="https://ai-fanout.com/"><strong>AI Fanout</strong><span>Turn topic paths into a reusable content skill.</span></a>
      <a href="https://seo-fanout.com/"><strong>SEO Fanout</strong><span>Turn SEO decisions into a reusable skill.</span></a>
      <a href="https://analysespider.com/"><strong>AnalyseSpider</strong><span>Review technical findings with the audit skill.</span></a>
      <a href="https://seo-mcp.de/capabilities"><strong>SEO MCP</strong><span>Understand required data capabilities before connecting.</span></a>
    </div>
  </section>
</BaseLayout>
