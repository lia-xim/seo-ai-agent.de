---
import type { GetStaticPaths } from "astro";
import PageIntro from "../../components/PageIntro.astro";
import type { TaskDefinition } from "../../data/tasks";
import { tasks } from "../../data/tasks";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  tasks.map((task) => ({ params: { slug: task.slug }, props: { task } }))) satisfies GetStaticPaths;

const { task } = Astro.props as { task: TaskDefinition };
const runHref = task.id === "SEO-AI-001"
  ? "/benchmarks/2026-08-22-technische-audit-triage"
  : task.id === "SEO-AI-003"
    ? "/benchmarks/2026-08-22-interne-link-evidenz"
    : null;
const taskMeta = task.status === "draft_spec"
  ? `ENTWURF / V${task.version} / KEIN LAUF`
  : task.id === "SEO-AI-003"
    ? `AUSGEFÜHRT / V${task.version} / PARTIAL`
    : `AUSGEFÜHRT / V${task.version} / REALER LAUF`;
---

<BaseLayout
  title={task.title}
  description={task.summary}
  canonicalPath={`/aufgaben/${task.slug}`}
>
  <PageIntro
    section={task.id.slice(-2)}
    title={task.title}
    description={task.summary}
    meta={taskMeta}
  />

  <div class="task-detail-grid">
    <article class="protocol">
      <section>
        <h2>Ziel</h2>
        <p>{task.goal}</p>
      </section>
      <section>
        <h2>Im Scope</h2>
        <ul>{task.inScope.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section>
        <h2>Nicht im Scope</h2>
        <ul>{task.outOfScope.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section>
        <h2>Erlaubte Quellen</h2>
        <ul>{task.allowedSources.map((item) => <li>{item}</li>)}</ul>
      </section>
    </article>

    <aside class="protocol-sidebar">
      <dl>
        <div><dt>Task ID</dt><dd>{task.id}</dd></div>
        <div><dt>Version</dt><dd>{task.version}</dd></div>
        <div><dt>Zugriff</dt><dd>Nur lesen</dd></div>
        <div><dt>Zeitlimit</dt><dd>{task.timeLimitMinutes} Minuten</dd></div>
        <div><dt>Kostenlimit</dt><dd>{task.costLimitEuro.toFixed(2).replace(".", ",")} EUR</dd></div>
        <div><dt>Abnahme</dt><dd>Durch eine Person</dd></div>
      </dl>
      <a class="button button-primary" href={`/seo-agent-skill?task=${task.slug}`}>Als SEO Agent Skill verwenden</a>
    </aside>
  </div>

  <section class="criteria-section">
    <div>
      <span class="section-number" aria-hidden="true">A</span>
      <h2>Abnahmekriterien</h2>
      <ol>{task.acceptanceCriteria.map((item) => <li>{item}</li>)}</ol>
    </div>
    <div>
      <span class="section-number" aria-hidden="true">F</span>
      <h2>Fehlsignale</h2>
      <ol>{task.failureSignals.map((item) => <li>{item}</li>)}</ol>
    </div>
  </section>

  <section class="stop-rule">
    <span>STOPPREGEL</span>
    <p>{task.stopRule}</p>
  </section>

  <section class="statement-band">
    <p>{task.status === "executed_once" ? "Zu dieser Spezifikation ist ein datierter First-Party-Lauf veröffentlicht. Prüfe Ergebnisstatus und Grenzen, bevor du sie in einen Skill übernimmst." : "Diese Spezifikation ist noch nicht als realer Lauf veröffentlicht. Methodik, Budget und Failure Handling bleiben vor einer Ausführung Pflicht."}</p>
    <div class="inline-links">
      {runHref && <a class="text-link" href={runHref}>Ausgeführten Lauf prüfen</a>}
      <a class="text-link" href="/methodik-und-konflikte">Evidenz- und Bewertungsmethodik</a>
      <a class="text-link" href="/faehigkeiten">Fähigkeiten und Kontrollen</a>
      <a class="text-link" href="/seo-agent-kosten">Taskbudget kalkulieren</a>
      <a class="text-link" href="/fehlerbehandlung-seo-agenten">Stop und Eskalation festlegen</a>
    </div>
  </section>
</BaseLayout>
