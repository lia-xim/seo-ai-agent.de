---
import PageIntro from "../../components/PageIntro.astro";
import { tasks } from "../../data/tasks";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Versionierte SEO-Agent-Aufgaben"
  description="Drei begrenzte SEO-Aufgaben mit Eingaben, Quellen, Zugriffen, Abnahme und Abbruchregeln."
  canonicalPath="/aufgaben"
  bodyClass="library-page"
  pageType="CollectionPage"
>
  <PageIntro    section="02"
    title="Drei Aufgaben. Klar begrenzt."
    description="Jede Aufgabe benennt Ziel, Scope, Quellen, Zugriff, Limits, erwartetes Ergebnis und Abbruchregel. SEO-AI-001 wurde einmal als First-Party-Lauf ausgeführt; eine Anbieter-Vergleichssaison gibt es nicht."
    meta="Bibliothek · V0.1 · EIN REALER LAUF"
  />

  <section class="task-library" aria-labelledby="library-title" data-reveal>
    <h2 id="library-title" class="visually-hidden">Aufgabenbibliothek</h2>
    <div class="task-library-head" aria-hidden="true">
      <span>ID</span><span>Aufgabe</span><span>Zugriff</span><span>Zeitlimit</span><span>Budget</span><span>Status</span><span></span>
    </div>
    {tasks.map((task, index) => (
      <details class="task-library-item" open={index === 1} data-reveal-item>
        <summary>
          <span class="task-id">{task.id}</span>
          <strong>{task.title}</strong>
          <span>Nur lesen</span>
          <span>{task.timeLimitMinutes} min</span>
          <span>{task.costLimitEuro.toFixed(2).replace(".", ",")} €</span>
          <span class="row-status">{task.status === "executed_once" ? "1 Lauf" : "Entwurf"}</span>
          <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
        </summary>
        <div class="task-library-detail">
          <div><h3>Ziel</h3><p>{task.goal}</p></div>
          <div><h3>Erlaubte Quellen</h3><p>{task.allowedSources.join(", ")}</p></div>
          <div><h3>Erwartetes Ergebnis</h3><p>{task.expectedOutput}</p></div>
          <div><h3>Abbruchregel</h3><p>{task.stopRule}</p></div>
          <footer>
            <a class="button button-primary button-compact" href={`/task-spec-builder?task=${task.slug}`}>
              Im Builder öffnen
              <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
            </a>
            <a class="button button-secondary button-compact" href={`/aufgaben/${task.slug}`}>Aufgabe ansehen</a>
          </footer>
        </div>
      </details>
    ))}
  </section>

  <section class="statement-band disclosure-band" data-reveal>
    <span class="info-mark" aria-hidden="true">i</span>
    <p>Ein echter First-Party-Tasklauf ist veröffentlicht. Es gibt keine Anbieter-Rangliste; Contextter erhält keinen automatischen Siegerstatus.</p>
    <a class="text-link" href="/benchmarks">Tasklauf prüfen</a>
  </section>
</BaseLayout>