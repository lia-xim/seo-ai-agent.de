---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Diese URL ist nicht Teil der aktuellen seo-ai-agent.de-Architektur."
  canonicalPath="/404"
  bodyClass="not-found-page"
>
  <section class="not-found">
    <span class="section-number" aria-hidden="true">404</span>
    <div>
      <h1>Dieser Pfad hat keine Aufgabe.</h1>
      <p>Diese URL gehört nicht zur aktuellen Seitenstruktur. Sie antwortet deshalb als echte 404 und wird nicht pauschal zur Startseite umgeleitet.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Zur Startseite</a>
        <a class="text-link" href="/aufgaben">Aufgaben ansehen</a>
      </div>
    </div>
  </section>
</BaseLayout>
