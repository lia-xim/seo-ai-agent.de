---
import BaseLayout from "../layouts/BaseLayout.astro";
import SeoAgentSkillChecker from "../components/SeoAgentSkillChecker.astro";
---

<BaseLayout
  title="SEO Agent Skill Checker: prüfen und reparieren"
  description="Prüfe und repariere SKILL.md, Cursor Rules und SEO-Agent-Prompts lokal mit formatspezifischen Regeln und reproduzierbarem SHA-256-QA-Report."
  canonicalPath="/seo-agent-skill-check"
  bodyClass="skill-check-page"
  structuredData={{ "@context": "https://schema.org", "@type": "SoftwareApplication", name: "SEO Agent Skill Checker", url: "https://seo-ai-agent.de/seo-agent-skill-check", applicationCategory: "DeveloperApplication", operatingSystem: "Web", inLanguage: "de", description: "Browser-lokaler, deterministischer Check mit Fix-Blöcken für SKILL.md, Cursor Rules und SEO-Agent-Prompts.", offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" } }}
>
  <section class="checker-hero"><div><h1>SEO Agent Skill prüfen.</h1><p>Einfügen, Ziel wählen, Fehler reparieren. Alles bleibt in deinem Browser.</p></div></section>
  <SeoAgentSkillChecker />
  <details class="checker-notes"><summary>Regeln und Grenzen</summary><p>Der Check bewertet dokumentierte Struktur, nicht die Qualität einer Ausführung. Formatquellen: <a href="https://geminicli.com/docs/cli/tutorials/skills-getting-started/">Gemini CLI</a>, <a href="https://docs.cursor.com/context/rules-for-ai">Cursor</a> und der <a href="/agent-skill-vergleich">Formatvergleich</a>.</p></details>
</BaseLayout>
