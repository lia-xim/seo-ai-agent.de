---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const costParts = [
  ["01", "Modell & Ausführung", "Tokens, Modellaufrufe, Browser- oder Laufzeitkosten pro Task."],
  ["02", "Bezahlte Daten", "Crawl-, SERP-, Keyword- oder API-Kosten, die nur nach Freigabe entstehen dürfen."],
  ["03", "Menschliche Prüfung", "Review, Freigabe, Korrektur und dokumentierte Übergabe – nicht nur Rechenzeit."],
  ["04", "Fehler & Wiederholungen", "Erwartete Retries, abgebrochene Läufe und ein sichtbarer Sicherheitspuffer."]
];
---

<BaseLayout
  title="Kosten von SEO-Agenten berechnen"
  description="Browser-lokaler Kostenrechner für SEO-Agent-Tasks: Modell, Daten, Review, Retries und Reserve transparent kalkulieren."
  canonicalPath="/seo-agent-kosten"
  bodyClass="cost-page"
>
  <PageIntro
    section="05.1"
    title="SEO-Agent-Kosten beginnen vor dem ersten Lauf."
    description="Berechne ein realistisches Task-Budget aus direkten Ausgaben, menschlicher Prüfung, Wiederholungen und Reserve. Die Eingaben bleiben lokal im Browser."
    meta="KOSTENRECHNER / LOKAL / KEINE MARKTPREISE"
  />

  <section class="cost-calculator" aria-labelledby="calculator-title" data-cost-calculator>
    <header class="section-heading">
      <div>
        <span class="eyebrow">Browser-lokales Werkzeug</span>
        <h2 id="calculator-title">Budget pro Tasklauf statt pauschaler Toolpreis.</h2>
        <p>Die Startwerte sind ein Rechenbeispiel, keine Preisbehauptung über Anbieter. Ersetze sie durch deine freigegebenen Konditionen und internen Review-Sätze.</p>
      </div>
      <p class="local-badge"><span class="status-dot" aria-hidden="true"></span> Keine Übertragung</p>
    </header>

    <div class="cost-workspace">
      <form class="cost-form" data-cost-form>
        <label>
          <span>Geplante Taskläufe</span>
          <input name="runs" type="number" min="1" step="1" value="10" inputmode="numeric" />
        </label>
        <label>
          <span>Modell &amp; Ausführung je Lauf</span>
          <span class="input-with-unit"><input name="execution" type="number" min="0" step="0.01" value="0.25" inputmode="decimal" /><em>EUR</em></span>
        </label>
        <label>
          <span>Bezahlte Daten je Lauf</span>
          <span class="input-with-unit"><input name="data" type="number" min="0" step="0.01" value="0.75" inputmode="decimal" /><em>EUR</em></span>
        </label>
        <label>
          <span>Menschlicher Review je Lauf</span>
          <span class="input-with-unit"><input name="reviewMinutes" type="number" min="0" step="1" value="12" inputmode="numeric" /><em>Min</em></span>
        </label>
        <label>
          <span>Interner Review-Satz</span>
          <span class="input-with-unit"><input name="hourlyRate" type="number" min="0" step="1" value="90" inputmode="decimal" /><em>EUR/h</em></span>
        </label>
        <label>
          <span>Erwartete Retry-Quote</span>
          <span class="input-with-unit"><input name="retryRate" type="number" min="0" max="100" step="1" value="10" inputmode="decimal" /><em>%</em></span>
        </label>
        <label>
          <span>Reserve</span>
          <span class="input-with-unit"><input name="reserve" type="number" min="0" max="100" step="1" value="15" inputmode="decimal" /><em>%</em></span>
        </label>
      </form>

      <aside class="cost-result" aria-live="polite" aria-atomic="true">
        <span class="eyebrow">Erwartetes Gesamtbudget</span>
        <output data-total>0,00 €</output>
        <p><strong data-per-run>0,00 €</strong> je geplantem Tasklauf</p>
        <dl>
          <div><dt>Direkte Ausführung</dt><dd data-direct>0,00 €</dd></div>
          <div><dt>Menschlicher Review</dt><dd data-review>0,00 €</dd></div>
          <div><dt>Erwartete Retries</dt><dd data-retries>0,00 €</dd></div>
          <div><dt>Reserve</dt><dd data-reserve>0,00 €</dd></div>
        </dl>
        <p class="result-note">Planwert, keine Rechnung und keine Prognose tatsächlicher Providerkosten. Nicht verbrauchtes Retry- oder Reservebudget bleibt ungenutzt.</p>
      </aside>
    </div>
  </section>

  <section class="cost-parts" aria-labelledby="parts-title">
    <h2 id="parts-title">Vier Kostenblöcke gehören in jede Task Recipe.</h2>
    <div>
      {costParts.map(([id, title, description]) => (
        <article><span>{id}</span><h3>{title}</h3><p>{description}</p></article>
      ))}
    </div>
  </section>

  <div class="two-column-section">
    <section>
      <h2>So wird aus dem Plan ein belastbarer Run</h2>
      <ul class="rule-list">
        <li>Direkte Providerkosten und interne Arbeitszeit getrennt protokollieren.</li>
        <li>Neue bezahlte Daten oder ein höheres Limit lösen vor dem Abruf eine Freigabe aus.</li>
        <li>Fehlversuche mit Ursache und Kosten behalten; nicht aus dem Ergebnis herausrechnen.</li>
        <li>Plan, Ist-Wert und Abweichung nach dem Lauf gemeinsam veröffentlichen.</li>
      </ul>
    </section>
    <section>
      <h2>Was dieser Rechner nicht weiß</h2>
      <p>Er kennt keine Providerpreise, Tokenmengen, Vertragsrabatte oder interne Personalkosten. Ohne reale Eingaben entsteht nur ein Szenario. Rankings, Umsatz oder Einsparungen werden nicht prognostiziert.</p>
      <a class="text-link" href="/fehlerbehandlung-seo-agenten">Stop-, Retry- und Eskalationsregeln festlegen</a>
    </section>
  </div>

  <section class="statement-band">
    <p>Übernimm das berechnete Limit erst nach Prüfung in die Task Recipe. Ein Budget ist eine Grenze, keine Erlaubnis für jeden Datenabruf.</p>
    <a class="text-link" href="/task-spec-builder">Task Recipe erstellen</a>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-cost-calculator]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-cost-form]")!;
    const euro = new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR" });
    const value = (name: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      return Math.max(0, Number(input.value) || 0);
    };
    const set = (selector: string, amount: number) => {
      const target = root.querySelector<HTMLElement>(selector);
      if (target) target.textContent = euro.format(amount);
    };
    const calculate = () => {
      const runs = Math.max(1, Math.round(value("runs")));
      const direct = runs * (value("execution") + value("data"));
      const review = runs * (value("reviewMinutes") / 60) * value("hourlyRate");
      const retries = direct * Math.min(100, value("retryRate")) / 100;
      const subtotal = direct + review + retries;
      const reserve = subtotal * Math.min(100, value("reserve")) / 100;
      const total = subtotal + reserve;
      set("[data-direct]", direct);
      set("[data-review]", review);
      set("[data-retries]", retries);
      set("[data-reserve]", reserve);
      set("[data-total]", total);
      set("[data-per-run]", total / runs);
    };
    form.addEventListener("input", calculate);
    calculate();
  }
</script>
