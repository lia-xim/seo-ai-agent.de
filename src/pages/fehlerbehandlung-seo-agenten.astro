---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const failureMatrix = [
  ["Pflichtinput fehlt", "Stoppen", "Keine Ersatzdaten erfinden. Fehlendes Feld, Owner und benötigte Freigabe nennen."],
  ["Temporärer Toolfehler", "Begrenzt wiederholen", "Nur bei unverändert sicherer Aktion; Retry-Zahl, Wartezeit und Kosten mitzählen."],
  ["Quelle widerspricht Quelle", "Eskalieren", "Beide Beobachtungen erhalten. Keine stille Mehrheitsentscheidung oder Glättung."],
  ["Berechtigung reicht nicht", "Stoppen", "Keinen Scope erweitern. Benötigten Zugriff und mögliche Auswirkung erklären."],
  ["Akzeptanzkriterium verfehlt", "Zurückweisen", "Output nicht als Erfolg markieren; Ursache, Teilresultat und nächsten Test dokumentieren."],
  ["Schreibaktion fehlgeschlagen", "Sichern & zurückrollen", "Weitere Mutationen stoppen, Diff und Zustand sichern, verantwortliche Person informieren."]
];

const contract = `failure_handling:
  owner: "NAME"
  max_retries_per_step: 1
  retry_only_if:
    - "Aktion ist idempotent oder sicher wiederholbar"
    - "Scope, Datenquelle und Kostenlimit bleiben unverändert"
  stop_if:
    - "Pflichtinput oder Evidenz fehlt"
    - "neue Berechtigung oder bezahlte Daten nötig"
    - "personenbezogene oder vertrauliche Daten erscheinen"
  escalate_with:
    - "letzte bestätigte Beobachtung"
    - "Fehler, Tool, Version und Zeitstempel"
    - "verbrauchte Zeit und Kosten"
    - "mögliche sichere nächste Schritte"
  rollback_owner: "NAME ODER NICHT ANWENDBAR"`;
---

<BaseLayout
  title="Fehlerbehandlung für SEO-Agenten"
  description="Stop-, Retry-, Fallback-, Eskalations- und Rollback-Regeln für kontrollierte SEO-Agent-Aufgaben definieren."
  canonicalPath="/fehlerbehandlung-seo-agenten"
>
  <PageIntro
    section="05.2"
    title="Ein guter SEO-Agent weiß, wann er stoppen muss."
    description="Lege vor dem Lauf fest, welche Fehler wiederholt werden dürfen, wann eine Person entscheidet und wie Teilresultate, Kosten und Änderungen gesichert werden."
    meta="FAILURE HANDLING / STOP / RETRY / ESCALATE"
  />

  <section class="failure-decision" aria-labelledby="failure-title">
    <header class="section-heading">
      <div>
        <span class="eyebrow">Entscheidungsmatrix</span>
        <h2 id="failure-title">Nicht jeder Fehler ist ein Retry.</h2>
        <p>Ein Retry ist nur sinnvoll, wenn sich die Ursache plausibel ändern kann und die Wiederholung innerhalb von Scope, Rechten und Budget bleibt.</p>
      </div>
    </header>
    <div class="failure-table">
      <div class="failure-table-head" aria-hidden="true"><span>Signal</span><span>Aktion</span><span>Pflichtnachweis</span></div>
      {failureMatrix.map(([signal, action, evidence]) => (
        <article><h3>{signal}</h3><strong>{action}</strong><p>{evidence}</p></article>
      ))}
    </div>
  </section>

  <section class="failure-contract" aria-labelledby="contract-title">
    <div>
      <span class="eyebrow">Kopierbarer Mindestvertrag</span>
      <h2 id="contract-title">Failure Handling vor dem Prompt einfrieren.</h2>
      <p>Die Werte sind eine Vorlage, keine universelle Norm. Kritische Schreibaktionen können null automatische Retries verlangen; sichere, idempotente Lesezugriffe können anders begrenzt werden.</p>
      <a class="text-link" href="/task-spec-builder">In eine Task Recipe übertragen</a>
    </div>
    <pre><code>{contract}</code></pre>
  </section>

  <div class="two-column-section">
    <section>
      <h2>Was im Laufprotokoll erhalten bleibt</h2>
      <ul class="rule-list">
        <li>Fehlerklasse, Tool und Version</li>
        <li>Zeitpunkt, Versuchszahl und Wartezeit</li>
        <li>Input-Referenz und letzte bestätigte Beobachtung</li>
        <li>Direkte Kosten und verbrauchte Laufzeit</li>
        <li>Entscheider, Freigabe und gewählter Rückweg</li>
      </ul>
    </section>
    <section>
      <h2>Warum diese Grenze belastbar ist</h2>
      <p>Das NIST AI Resource Center beschreibt dokumentierte Test-, Evaluations-, Verifikations- und Validierungsprozesse sowie Monitoring, Incident Response, Recovery und menschliches Eingreifen als Teile des AI-Risikomanagements. Diese Seite überträgt das als eigenständige, taskbezogene Checkliste auf SEO-Agent-Workflows; sie behauptet keine NIST-Prüfung.</p>
      <a class="text-link" href="https://airc.nist.gov/airmf-resources/playbook/manage/">NIST AI RMF Playbook: Manage</a>
    </section>
  </div>

  <section class="statement-band">
    <p>Retries dürfen Fehler nicht verstecken. Jeder Versuch bleibt Teil von Zeit, Kosten und Ergebnisstatus.</p>
    <a class="text-link" href="/seo-agent-kosten">Retry-Budget berechnen</a>
  </section>
</BaseLayout>
