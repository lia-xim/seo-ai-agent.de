{
  "name": "seo-ai-agent-de",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Projektgrundlage für reproduzierbare, aufgabenbezogene Tests von SEO-Agenten.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa": "node scripts/qa.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "qa:csp": "node scripts/csp-contract.mjs --check",
    "qa:csp:update": "node scripts/csp-contract.mjs --write",
    "qa:status": "node scripts/status-qa.mjs",
    "verify": "pnpm build && pnpm qa && pnpm qa:csp && pnpm qa:status"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "7.2.1",
    "fflate": "0.8.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "^4.13.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.2"
}
