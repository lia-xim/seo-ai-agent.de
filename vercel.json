{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.seo-ai-agent.de"
        }
      ],
      "destination": "https://seo-ai-agent.de/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.seo-ai-agent.de"
        }
      ],
      "destination": "https://seo-ai-agent.de/:path*",
      "permanent": true
    }
  ]
}
